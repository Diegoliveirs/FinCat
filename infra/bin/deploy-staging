#!/usr/bin/env bash
set -euo pipefail

image_ref=${1:?Informe a imagem runtime.}
migration_image_ref=${2:?Informe a imagem de migrations.}
root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
compose_file="$root_dir/infra/compose.staging.yaml"

resolve_digest() {
  docker pull "$1" >&2
  docker image inspect --format '{{index .RepoDigests 0}}' "$1"
}

runtime_digest=$(resolve_digest "$image_ref")
migration_digest=$(resolve_digest "$migration_image_ref")

IMAGE_REF="$runtime_digest" MIGRATION_IMAGE_REF="$migration_digest" \
  docker compose --project-name fincat-staging -f "$compose_file" run --rm migrate
IMAGE_REF="$runtime_digest" MIGRATION_IMAGE_REF="$migration_digest" \
  docker compose --project-name fincat-staging -f "$compose_file" run --rm migrate npm run db:bootstrap

IMAGE_REF="$runtime_digest" MIGRATION_IMAGE_REF="$migration_digest" \
  docker compose --project-name fincat-staging -f "$compose_file" up -d --no-deps --force-recreate app

for _ in {1..30}; do
  if curl --fail --silent --show-error --max-time 3 http://127.0.0.1:3001/api/health >/dev/null; then
    printf 'Staging ativo com %s\n' "$runtime_digest"
    exit 0
  fi
  sleep 2
done

docker compose --project-name fincat-staging -f "$compose_file" logs --tail=100 app >&2
exit 1
