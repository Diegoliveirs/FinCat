#!/usr/bin/env bash
set -euo pipefail

env_file=${1:-/opt/fincat/deploy/.env.postgres}
root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
compose_file="$root_dir/infra/compose.postgres.yaml"

if test ! -f "$env_file"; then
  printf 'Arquivo protegido não encontrado: %s\n' "$env_file" >&2
  exit 1
fi

set -a
. "$env_file"
set +a

for required in POSTGRES_SUPERUSER POSTGRES_SUPERUSER_PASSWORD STAGING_DB_USER STAGING_DB_PASSWORD PROD_DB_USER PROD_DB_PASSWORD; do
  if test -z "${!required:-}"; then
    printf 'Variável obrigatória ausente: %s\n' "$required" >&2
    exit 1
  fi
done

create_database() {
  local db_name=$1 app_user=$2 app_password=$3
  docker compose --env-file "$env_file" -f "$compose_file" exec -T postgres \
    psql -U "$POSTGRES_SUPERUSER" -d postgres -v ON_ERROR_STOP=1 \
      -v app_user="$app_user" -v app_password="$app_password" -v app_database="$db_name" <<'SQL'
SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'app_user', :'app_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'app_user')
\gexec
SELECT format('CREATE DATABASE %I OWNER %I', :'app_database', :'app_user')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'app_database')
\gexec
SQL
}

create_database fincat_staging "$STAGING_DB_USER" "$STAGING_DB_PASSWORD"
create_database fincat_prod "$PROD_DB_USER" "$PROD_DB_PASSWORD"
printf 'Bancos PostgreSQL de staging e produção prontos.\n'
